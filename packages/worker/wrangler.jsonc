{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edit",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  // Production is served only on the custom domain below.
  "workers_dev": false,
  // preview_urls defaults to workers_dev (false here), so it needs to be
  // opted back in explicitly — otherwise branch Previews
  // (<branch>-edit.<subdomain>.workers.dev) and version URLs never get a
  // *.workers.dev URL to view at all.
  "preview_urls": true,
  // Custom domain — requires piconic.ai to be on Cloudflare DNS.
  // Cloudflare auto-provisions the CNAME and TLS certificate.
  "routes": [{ "pattern": "edit.piconic.ai", "custom_domain": true }],
  // The web editor (built by @pedit/web) is served by Workers Assets; only /api/*
  // reaches the Worker script. Any other path falls back to index.html.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Keep invocation logs in Workers Logs (Cloudflare dashboard → piconic edit Worker →
  // Observability). Only paths and status codes are logged; the key lives in
  // the URL fragment and never reaches the Worker.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Encrypted attachments, kept only while a room's host is connected. Each
  // bucket needs a lifecycle rule expiring `rooms/` after a day, as a backstop
  // for deletion (see docs/contributing/deployment.md and docs/self-hosting.md).
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "edit-blobs" }],
  // Worker Previews: every push to a branch other than `release` makes (or
  // updates) that branch's Preview via Cloudflare Workers Builds, whose
  // Preview command runs `pnpm run preview`. Previews never become the
  // production deployment. They inherit no bindings from the settings above,
  // so the bindings are declared again here; each Preview gets its own
  // Durable Object namespace automatically. All Previews share one bucket:
  // blobs live under their room's Durable Object id, which differs per namespace.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOM", "class_name": "Room" }]
    },
    "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "edit-blobs-preview" }],
    // Per-Preview logs and traces: Cloudflare dashboard → piconic edit Worker →
    // Previews → <branch> → Observability. (`wrangler tail` can't target
    // Previews.)
    "observability": {
      "enabled": true,
      "logs": { "enabled": true, "invocation_logs": true },
      "traces": { "enabled": true, "head_sampling_rate": 1 }
    }
  },
  "env": {
    // A separate Worker (`edit-lab`) for trying things that should not touch
    // production, such as putting the whole host behind Cloudflare Access.
    // It is also a rehearsal of self-hosting: a second copy of pedit deployed
    // from this repository. Deploy it by hand with `pnpm run deploy:lab`;
    // Workers Builds never deploys it.
    "lab": {
      "name": "edit-lab",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "edit-lab.piconic.ai", "custom_domain": true }],
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "edit-lab-blobs" }]
    }
  }
}
