{
  "name": "pedit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --dir packages run build",
    "deploy": "pnpm --dir packages run deploy",
    "deploy:production": "pnpm --dir packages run deploy:production",
    "test:deploy": "pnpm --dir packages run test:deploy",
    "deploy:lab": "pnpm --dir packages run deploy:lab",
    "preview": "pnpm --dir packages run preview",
    "typecheck": "pnpm --dir packages run typecheck",
    "test": "pnpm --dir packages run test",
    "lint": "packages/node_modules/.bin/biome check .",
    "format": "packages/node_modules/.bin/biome format --write .",
    "postinstall": "pnpm --dir packages install --frozen-lockfile"
  }
}
